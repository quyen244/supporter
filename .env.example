# Chuỗi kết nối PostgreSQL. Trên Vercel, biến này do tích hợp Neon tự gắn vào.
DATABASE_URL=postgres://user:password@host:5432/phieu

# Khoá ký phiên đăng nhập. Tạo bằng: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Địa chỉ gốc của ứng dụng. Trên Vercel điền đúng tên miền đang chạy.
BETTER_AUTH_URL=http://localhost:3000

# Các email được cấp quyền quản trị ngay khi đăng ký, cách nhau bởi dấu phẩy.
ADMIN_EMAILS=
